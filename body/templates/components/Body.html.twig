{# @prop size 'large'|'small' The text size. Defaults to normal size #}
{# @prop bold boolean Whether to render the text with strong weight. Defaults to false #}
{# @prop muted boolean Whether to render the text in a muted color. Defaults to false #}
{# @prop as The HTML tag to render. Defaults to `p` #}
{%- props size = null, bold = false, muted = false, as = 'p' -%}

{%- set style = html_cva(
    base: 'kern-body',
    variants: {
        size: {
            large: 'kern-body--large',
            small: 'kern-body--small',
        },
        bold: {
            true: 'kern-body--bold',
        },
        muted: {
            true: 'kern-body--muted',
        },
    },
) -%}

<{{ as }} class="{{ style.apply({size, bold, muted}, attributes.render('class')) }}" {{ attributes }}>
    {%- block content %}{% endblock -%}
</{{ as }}>
