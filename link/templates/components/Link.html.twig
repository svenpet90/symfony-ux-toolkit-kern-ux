{# @prop size 'small' The link size. Defaults to normal size #}
{# @prop stretched boolean Whether the link should stretch to fill its nearest positioned ancestor. Defaults to false #}
{# @prop noVisitedState boolean Whether to suppress the distinct visited color. Defaults to false #}
{# @block content The link text, optionally combined with an `<twig:Icon>` #}
{%- props size = '', stretched = false, noVisitedState = false -%}

{%- set style = html_cva(
    base: 'kern-link',
    variants: {
        size: {
            small: 'kern-link--small',
        },
        stretched: {
            true: 'kern-link--stretched',
        },
        noVisitedState: {
            true: 'kern-link--no-visited-state',
        },
    },
) -%}

<a class="{{ style.apply({size, stretched, noVisitedState}, attributes.render('class')) }}" {{ attributes }}>
    {%- block content %}{% endblock -%}
</a>
