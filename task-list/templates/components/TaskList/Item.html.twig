{# @prop number The task step number #}
{# @prop title The task description, rendered as the (stretched) link text #}
{# @prop href The task link target. Defaults to `#` #}
{# @prop id Base id used to wire the link to its status via aria-describedby #}
{# @block content The status area, typically a `<twig:Badge>` #}
{%- props number = null, title = null, href = '#', id = null -%}

<li class="kern-task-list__item">
    <div class="kern-task-list__title"{% if id %} id="{{ id }}-title"{% endif %}>
        <a href="{{ href }}" class="kern-link kern-link--stretched kern-task-list__content-wrapper"{% if id %} aria-describedby="{{ id }}-status"{% endif %}>
            {%- if number is not null %}<span class="kern-number">{{ number }}</span>{% endif -%}
            <span>{{ title }}</span>
        </a>
        <div class="kern-task-list__status"{% if id %} id="{{ id }}-status"{% endif %}>
            {%- block content %}{% endblock -%}
        </div>
    </div>
</li>
