{# @prop title The accordion header text #}
{# @prop open boolean Whether the accordion is expanded by default. Defaults to false #}
{# @block content The collapsible body content #}
{%- props title = null, open = false -%}

<details class="kern-accordion {{ attributes.render('class') }}"{% if open %} open{% endif %} {{ attributes }}>
    <summary class="kern-accordion__header">
        <span class="kern-title">{{ title }}</span>
    </summary>
    <section class="kern-accordion__body">
        {%- block content %}{% endblock -%}
    </section>
</details>
