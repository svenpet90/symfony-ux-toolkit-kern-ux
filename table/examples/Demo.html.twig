<twig:Table title="Öffnungszeiten" striped="true" responsive="true">
    <twig:Table:Head>
        <twig:Table:Row>
            <twig:Table:Header>Tag</twig:Table:Header>
            <twig:Table:Header variant="numeric">Von</twig:Table:Header>
            <twig:Table:Header variant="numeric">Bis</twig:Table:Header>
            <twig:Table:Header variant="action">Aktion</twig:Table:Header>
        </twig:Table:Row>
    </twig:Table:Head>
    <twig:Table:Body>
        <twig:Table:Row>
            <twig:Table:Header scope="row">Montag</twig:Table:Header>
            <twig:Table:Cell variant="numeric">08:00</twig:Table:Cell>
            <twig:Table:Cell variant="numeric">16:00</twig:Table:Cell>
            <twig:Table:Cell variant="action">
                <twig:Button variant="tertiary" size="x-small">Details</twig:Button>
            </twig:Table:Cell>
        </twig:Table:Row>
    </twig:Table:Body>
</twig:Table>
