{# @prop size 'large'|'small' The preline size. Defaults to normal size #}
{# @prop as The HTML tag to render. Defaults to `p` #}
{%- props size = '', as = 'p' -%}

{%- set style = html_cva(
    base: 'kern-preline',
    variants: {
        size: {
            large: 'kern-preline--large',
            small: 'kern-preline--small',
        },
    },
) -%}

<{{ as }} class="{{ style.apply({size}, attributes.render('class')) }}" {{ attributes }}>
    {%- block content %}{% endblock -%}
</{{ as }}>
