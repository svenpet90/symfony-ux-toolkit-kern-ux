{# @prop variant 'info'|'success'|'warning'|'danger' The badge style variant #}
{# @prop size 'small' The badge size. Defaults to normal size #}
{# @prop icon The optional KERN icon name shown before the label #}
{%- props variant = '', size = '', icon = null -%}

{%- set style = html_cva(
    base: 'kern-badge',
    variants: {
        variant: {
            info: 'kern-badge--info',
            success: 'kern-badge--success',
            warning: 'kern-badge--warning',
            danger: 'kern-badge--danger',
        },
        size: {
            small: 'kern-badge--small',
        },
    },
) -%}

<span class="{{ style.apply({variant, size}, attributes.render('class')) }}" {{ attributes }}>
    {%- if icon %}<span class="kern-icon kern-icon--{{ icon }}" aria-hidden="true"></span>{% endif -%}
    <span class="kern-label">{%- block content %}{% endblock -%}</span>
</span>
