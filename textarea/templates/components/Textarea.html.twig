{# @prop label The field label #}
{# @prop name The textarea name attribute #}
{# @prop id The textarea id. Defaults to `name` #}
{# @prop value The textarea value #}
{# @prop hint Optional guidance text shown above the textarea #}
{# @prop error Optional error message; when set the field renders in its error state #}
{# @prop optional Optional suffix appended to the label, e.g. `- Optional` #}
{# @prop rows The number of visible text rows. Defaults to 5 #}
{# @prop placeholder Optional placeholder text #}
{%- props label = null, name = null, id = null, value = null, hint = null, error = null, optional = null, rows = 5, placeholder = null -%}
{%- set id = id ?? name -%}
{%- set describedby = [hint ? id ~ '-hint' : '', error ? id ~ '-error' : '']|filter(v => v)|join(' ') -%}

<div class="kern-form-input{% if error %} kern-form-input--error{% endif %} {{ attributes.render('class') }}">
    <label class="kern-label" for="{{ id }}">{{ label }}{% if optional %} <span class="kern-label__optional">{{ optional }}</span>{% endif %}</label>
    {%- if hint %}<div class="kern-hint" id="{{ id }}-hint">{{ hint }}</div>{% endif -%}
    <textarea
        class="kern-form-input__input{% if error %} kern-form-input__input--error{% endif %}"
        id="{{ id }}"
        {%- if name %} name="{{ name }}"{% endif %}
        rows="{{ rows }}"
        {%- if placeholder %} placeholder="{{ placeholder }}"{% endif %}
        {%- if error %} aria-invalid="true"{% endif %}
        {%- if describedby %} aria-describedby="{{ describedby }}"{% endif %}
        {{ attributes.without('class') }}
    >{{ value }}</textarea>
    {%- if error %}<p class="kern-error" id="{{ id }}-error"><span class="kern-icon kern-icon--danger" aria-hidden="true"></span><span class="kern-body">{{ error }}</span></p>{% endif -%}
</div>
